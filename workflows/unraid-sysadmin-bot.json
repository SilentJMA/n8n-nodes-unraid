      "name": "Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        -920,
        200
      ],
      "webhookId": "4003f1ba-ea49-48ee-a1ac-38f53bb9e0b4"
