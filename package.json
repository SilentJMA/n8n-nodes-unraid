{
  "name": "@silentjma/n8n-nodes-unraid",
  "version": "0.1.1",
  "description": "Unofficial n8n community nodes for the Unraid GraphQL API: Docker, array, VMs, logs, notifications and a polling trigger for log/alert watching.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "unraid",
    "docker",
    "graphql",
    "homelab"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohamed Ayoub Jabane",
    "email": "16384750+SilentJMA@users.noreply.github.com",
    "url": "https://github.com/SilentJMA"
  },
  "homepage": "https://github.com/SilentJMA/n8n-nodes-unraid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilentJMA/n8n-nodes-unraid.git"
  },
  "bugs": {
    "url": "https://github.com/SilentJMA/n8n-nodes-unraid/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/kilwanitrod"
  },
  "files": [
    "dist/credentials/**",
    "dist/nodes/**",
    "dist/lib/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/assets.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepack": "npm run build",
    "workflow": "node scripts/build-workflows.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/UnraidApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Unraid/Unraid.node.js",
      "dist/nodes/UnraidTrigger/UnraidTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.29.0",
    "@n8n/eslint-plugin-community-nodes": "0.37.0",
    "@types/node": "22.20.5",
    "eslint": "9.29.0",
    "eslint-plugin-n8n-nodes-base": "1.16.7",
    "n8n-workflow": "2.43.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
