    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst unknown = j.command !== 'help' && j.group !== 'help';\nconst text = [\n  unknown ? `❓ Unknown command <code>${String(j.text).replace(/[<>&]/g, '')}</code>\\n` : '🖥️ <b>Unraid bot</b>',\n  '<b>Server</b>\\n/status — health report with next steps\\n/info — uptime, CPU, RAM, array usage\\n/disks — disk status, temps, usage\\n/parity — parity status (/parity_start, /parity_pause, /parity_resume, /parity_cancel)\\n/syslog — recent warnings in the syslog\\n/notifications — unread Unraid notifications (/archive_all)\\n/vms — virtual machines',\n  '<b>Docker</b>\\n/containers — list with quick actions\\n/updates — check for image updates\\n/update_all — update everything (asks first)\\n/update_&lt;name&gt; · /restart_&lt;name&gt; · /start_&lt;name&gt; · /stop_&lt;name&gt; · /logs_&lt;name&gt;',\n].join('\\n\\n');\nreturn [{ json: { chatId: j.chatId, text } }];"
      },
