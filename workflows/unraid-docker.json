    {
      "parameters": {
        "jsCode": "// Databases and other stateful apps are best updated by hand; list them in Settings.\nconst cfg = $('Plan').first().json.cfg ?? {};\nconst excluded = new Set(String(cfg.excludeFromUpdates ?? '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean));\nconst all = $input.all().map((i) => i.json.name).filter(Boolean);\nreturn [{ json: { names: all.filter((n) => !excluded.has(n.toLowerCase())), skipped: all.filter((n) => excluded.has(n.toLowerCase())) } }];"
      },
      "id": "c2013e7b-4945-40fa-afc5-9fd0fc6893e7",
      "name": "Apply exclusions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        320
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "fef1537b-4f08-46b9-a759-6ca4c9eb0088",
              "leftValue": "={{ $json.names.length > 0 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5fef20ce-7191-40ea-a698-95cd0a33cf24",
      "name": "Anything to update?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1020,
        320
      ]
    },
    {
      "parameters": {
        "resource": "dockerContainer",
        "operation": "update",
        "containers": "={{ $json.names }}"
      },
      "id": "77c996f1-0bcb-4e96-ae80-f2cdae1a4dd8",
      "name": "Update containers",
      "type": "CUSTOM.unraid",
      "typeVersion": 1,
      "position": [
        1020,
        480
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst plan = $('Plan').first().json;\nconst skipped = $('Apply exclusions').isExecuted ? ($('Apply exclusions').first().json.skipped ?? []) : [];\nconst items = $input.all().map((i) => i.json);\nconst skippedLine = skipped.length ? `\\nSkipped (excluded): ${esc(skipped.join(', '))}` : '';\nlet text;\nif (items.some((i) => i.error)) {\n  text = `❌ <b>Update failed</b>\\n${esc(items.map((i) => i.error).filter(Boolean).join('\\n'))}`;\n} else if (!items.some((i) => i.name)) {\n  // Nothing to update: stay quiet on the weekly run.\n  if (plan.scheduled) return [];\n  text = `✅ Nothing to update.${skippedLine}`;\n} else {\n  const done = items.filter((i) => i.name).map((i) => `• <b>${esc(i.name)}</b>: ${esc(String(i.state).toLowerCase())} (${esc(i.image)})`);\n  text = `⬆️ <b>Updated ${done.length} container(s)</b>${plan.scheduled ? ' (weekly window)' : ''}\\n${done.join('\\n')}${skippedLine}`;\n}\nreturn [{ json: { chatId: plan.chatId, text } }];"
      },
      "id": "acb6e236-ad1a-4ec9-a3f3-55e389b26610",
      "name": "Format update result",
